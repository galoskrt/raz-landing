# Static page under a WordPress docroot. Nothing here is dynamic, so keep
# WordPress out of the way entirely.
DirectoryIndex index.html
Options -Indexes
RewriteEngine Off

# Not for Google until launch. Remove this block on the day we go live.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json    "access plus 7 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/webp          "access plus 30 days"
  ExpiresByType image/jpeg          "access plus 30 days"
  ExpiresByType image/svg+xml       "access plus 30 days"
  ExpiresByType text/css            "access plus 30 days"
  ExpiresByType text/html           "access plus 5 minutes"
</IfModule>

# The icons are 305 KB raw and 26 KB compressed, so this block is most of the
# page weight. nginx in front does not compress JSON on its own.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/json application/javascript text/javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/x-font-ttf font/woff2
</IfModule>
